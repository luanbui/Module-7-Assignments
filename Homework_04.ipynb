    "# Your code here, add additional cells if you wish\n",
    "\n",
    "he = initializers.HeNormal()                                # best initializer for relu\n",
    "\n",
    "model_baseline= models.Sequential([\n",
    "    Input(shape=X_train.shape[1:]),\n",
    "\n",
    "    Conv2D(32, (3,3), activation='relu', kernel_initializer=he, padding=\"same\"),\n",
    "    BatchNormalization(), \n",
    "    MaxPooling2D(2),\n",
    "\n",
    "    Conv2D(64, (3,3), activation=\"relu\", kernel_initializer=he, padding=\"same\"),\n",
    "    MaxPooling2D(2),\n",
    "\n",
    "    Flatten(),\n",
    "    Dense(64, activation=\"relu\",kernel_initializer=he), \n",
    "    \n",
    "    Dropout(0.5),\n",
    "    Dense(num_classes, activation=\"softmax\")\n",
    "])\n",
    "\n",
    "train_and_test(model_baseline,title=\"Baseline Model\")\n",
    "\n",
    "#2: Widen Conv layers (64 -> 128)\n",
    "model_tweak2 = models.Sequential([\n",
    "    Input(shape=X_train.shape[1:]),\n",
    "    Conv2D(64, (3,3), activation='relu', kernel_initializer=he, padding=\"same\"),\n",
    "    MaxPooling2D(2),\n",
    "    Conv2D(128, (3,3), activation=\"relu\", kernel_initializer=he, padding=\"same\"),\n",
    "    MaxPooling2D(2),\n",
    "    Flatten(),\n",
    "    Dense(64, activation=\"relu\", kernel_initializer=he),\n",
    "    Dropout(0.5),\n",
    "    Dense(num_classes, activation=\"softmax\")\n",
    "])\n",
    "train_and_test(model_tweak2, title=\"Baseline Plus and Tweak 2\")\n",
    "\n",
    "#3: Add extra Conv layer (32 -> 64 -> 128)\n",
    "model_tweak3 = models.Sequential([\n",
    "    Input(shape=X_train.shape[1:]),\n",
    "    Conv2D(32, (3,3), activation='relu', kernel_initializer=he, padding=\"same\"),\n",
    "    MaxPooling2D(2),\n",
    "    Conv2D(64, (3,3), activation=\"relu\", kernel_initializer=he, padding=\"same\"),\n",
    "    MaxPooling2D(2),\n",
    "    Conv2D(128, (3,3), activation=\"relu\", kernel_initializer=he, padding=\"same\"),\n",
    "    MaxPooling2D(2),\n",
    "    Flatten(),\n",
    "    Dense(64, activation=\"relu\", kernel_initializer=he),\n",
    "    Dropout(0.5),\n",
    "    Dense(num_classes, activation=\"softmax\")\n",
    "])\n",
    "train_and_test(model_tweak3, title=\"Baseline Plus and Tweak 3\")\n",
    "\n",
    "#6: Modify dropout rate (0.5 -> 0.3)\n",
    "model_tweak6 = models.Sequential([\n",
    "    Input(shape=X_train.shape[1:]),\n",
    "    Conv2D(32, (3,3), activation='relu', kernel_initializer=he, padding=\"same\"),\n",
    "    MaxPooling2D(2),\n",
    "    Conv2D(64, (3,3), activation=\"relu\", kernel_initializer=he, padding=\"same\"),\n",
    "    MaxPooling2D(2),\n",
    "    Flatten(),\n",
    "    Dense(64, activation=\"relu\", kernel_initializer=he),\n",
    "    Dropout(0.3),\n",
    "    Dense(num_classes, activation=\"softmax\")\n",
    "])\n",
    "train_and_test(model_tweak6, title=\"Baseline and Tweak 6\")\n"
   ]
