    "he = initializers.HeNormal()\n",
    "\n",
    "def build_bn_model():\n",
    "    return models.Sequential([\n",
    "        Input(shape=X_train.shape[1:]),\n",
    "        Conv2D(64, (3,3), activation='relu', kernel_initializer=he, padding=\"same\"),\n",
    "        BatchNormalization(),\n",
    "        MaxPooling2D(2),\n",
    "        Conv2D(128, (3,3), activation=\"relu\", kernel_initializer=he, padding=\"same\"),\n",
    "        BatchNormalization(),\n",
    "        GlobalAveragePooling2D(),\n",
    "        Dense(num_classes, activation=\"softmax\")\n",
    "    ])\n",
    "\n",
    "tf.keras.backend.clear_session()\n",
    "gc.collect()\n",
    "reduce_lr_1 = ReduceLROnPlateau(monitor='val_loss', factor=0.5, patience=3, \n",
    "                                 min_delta=1e-4, cooldown=1, min_lr=1e-5, verbose=0)\n",
    "model_1 = build_bn_model()\n",
    "train_and_test(model_1, title=\"Factor=0.5, Patience=3\", \n",
    "               callbacks=[reduce_lr_1], patience=20, batch_size=64)\n",
    "del model_1\n",
    "gc.collect()\n",
    "\n",
    "tf.keras.backend.clear_session()\n",
    "gc.collect()\n",
    "reduce_lr_2 = ReduceLROnPlateau(monitor='val_loss', factor=0.3, patience=3, \n",
    "                                 min_delta=1e-4, cooldown=1, min_lr=1e-5, verbose=0)\n",
    "model_2 = build_bn_model()\n",
    "train_and_test(model_2, title=\"Factor=0.3, Patience=3\", \n",
    "               callbacks=[reduce_lr_2], patience=20, batch_size=64)\n",
    "del model_2\n",
    "gc.collect()\n",
    "\n",
    "tf.keras.backend.clear_session()\n",
    "gc.collect()\n",
    "reduce_lr_3 = ReduceLROnPlateau(monitor='val_loss', factor=0.7, patience=3, \n",
    "                                 min_delta=1e-4, cooldown=1, min_lr=1e-5, verbose=0)\n",
    "model_3 = build_bn_model()\n",
    "train_and_test(model_3, title=\"Factor=0.7, Patience=3\", \n",
    "               callbacks=[reduce_lr_3], patience=20, batch_size=64)\n",
    "del model_3\n",
    "gc.collect()\n",
    "\n",
    "tf.keras.backend.clear_session()\n",
    "gc.collect()\n",
    "reduce_lr_4 = ReduceLROnPlateau(monitor='val_loss', factor=0.5, patience=5, \n",
    "                                 min_delta=1e-4, cooldown=1, min_lr=1e-5, verbose=0)\n",
    "model_4 = build_bn_model()\n",
    "train_and_test(model_4, title=\"Factor=0.5, Patience=5\", \n",
    "               callbacks=[reduce_lr_4], patience=25, batch_size=64)\n",
    "del model_4\n",
    "gc.collect()\n"
   ]
